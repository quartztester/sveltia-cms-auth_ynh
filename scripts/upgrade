#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Stopping $app's systemd service..."
ynh_systemctl --service="$app" --action="stop"

site_hosts=$(ynh_app_setting_get --key=site_hosts)
github_client_id=$(ynh_app_setting_get --key=github_client_id)
# Secret was never a setting (YunoHost scrubs password asks) — the
# rendered env file is its persistent home; read it back from there.
github_client_secret=$(sed -n 's/^GITHUB_CLIENT_SECRET=//p' "$install_dir/env" 2>/dev/null)
: "${github_client_secret:?Missing GITHUB_CLIENT_SECRET in $install_dir/env}"

ynh_script_progression "Upgrading Node.js and source files..."

ynh_nodejs_install
ynh_setup_source --dest_dir="$install_dir/src" --full_replace
install -D -m 0644 "$install_dir/src/src/index.js" "$install_dir/worker.js"
rm -rf "$install_dir/src"

ynh_script_progression "Updating $app's configuration files..."
render_app_configs
chown -R "$app:$app" "$install_dir"

ynh_script_progression "Upgrading system configurations related to $app..."

mkdir -p "/var/log/$app"
chown "$app:$app" "/var/log/$app"

node_bin="$nodejs_dir/node"
ynh_config_add_systemd
ynh_config_add_nginx
ynh_config_add_logrotate

yunohost service add "$app" --description="Sveltia CMS OAuth authenticator" --log="/var/log/$app/$app.log"

ynh_script_progression "Starting $app's systemd service..."
ynh_systemctl --service="$app" --action="start"
wait_for_listen

ynh_script_progression "Upgrade of $app completed"
