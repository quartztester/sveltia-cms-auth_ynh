#!/bin/bash

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Restoring the app main directory..."

ynh_restore "$install_dir"
chown -R "$app:$app" "$install_dir"

# The env file (which carries the OAuth secrets) is re-rendered from the app
# settings, which are the single source of truth, rather than trusting the
# copy inside the archive.
ynh_script_progression "Re-applying $app's configuration from settings..."

site_hosts=$(ynh_app_setting_get --key=site_hosts)
github_client_id=$(ynh_app_setting_get --key=github_client_id)
github_client_secret=$(ynh_app_setting_get --key=github_client_secret)
ynh_nodejs_install
render_app_configs
chown -R "$app:$app" "$install_dir"

ynh_script_progression "Restoring system configurations related to $app..."

mkdir -p "/var/log/$app"
chown "$app:$app" "/var/log/$app"
ynh_restore "/var/log/$app/" || true

ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"

ynh_restore "/etc/systemd/system/$app.service"
systemctl enable "$app.service" --quiet

ynh_restore "/etc/logrotate.d/$app"

yunohost service add "$app" --description="Sveltia CMS OAuth authenticator" --log="/var/log/$app/$app.log"

ynh_script_progression "Reloading NGINX web server and $app's service..."

ynh_systemctl --service="$app" --action="start"
wait_for_listen

ynh_systemctl --service=nginx --action=reload

ynh_script_progression "Restoration completed for $app"
