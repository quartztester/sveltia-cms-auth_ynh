#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

ynh_abort_if_errors

#=================================================
# LOAD CURRENT SETTINGS
#=================================================

# NOTE: panel answers arrive as shell vars named after the short keys — do NOT re-fetch those from settings, that would clobber the new values.
install_dir=$(ynh_app_setting_get --key=install_dir)
port=$(ynh_app_setting_get --key=port)

#=================================================
# APPLY NEW SETTINGS
#=================================================

# Re-render the env file the settings feed so the service picks up new credentials on restart (core restarts it afterwards).
ynh_app_config_apply() {
    _ynh_app_config_apply
    # Fall back to stored settings only when the panel passed no answers
    # (e.g. a plain "apply" with no changes).
    site_hosts=${site_hosts:-$(ynh_app_setting_get --key=site_hosts)}
    github_client_id=${github_client_id:-$(ynh_app_setting_get --key=github_client_id)}
    github_client_secret=${github_client_secret:-$(ynh_app_setting_get --key=github_client_secret)}
    ynh_config_add --template="env" --destination="$install_dir/env"
    chmod 600 "$install_dir/env"
    chown "$app:$app" "$install_dir/env"
}

#=================================================
# END OF SCRIPT
#=================================================

ynh_app_config_run "$1"
